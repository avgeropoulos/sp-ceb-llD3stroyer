<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The game itself never goes online: every page request is answered from the APK by AssetServer.
         The network is used only by AppUpdater to look for and download a newer APK of this app (and
         WebView needs the permission anyway, or it blocks https:// page loads with ERR_CACHE_MISS). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The sensors run at exactly 200 Hz (5000 µs); this keeps Android 12+ from capping them below that. -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <!-- One-tap updates: lets the app hand a downloaded update to Android's installer, where the player confirms it. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Motion controls are optional: the game also plays with touch. -->
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />

    <!-- Lets the game find the phone's text-to-speech engine for the voice lines. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:appCategory="game"
        android:enableOnBackInvokedCallback="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
        android:usesCleartextTraffic="false">

        <!-- The game only loads its own assets, so there is nothing for Safe Browsing to check. -->
        <meta-data android:name="android.webkit.WebView.EnableSafeBrowsing" android:value="false" />
        <meta-data android:name="android.webkit.WebView.MetricsOptOut" android:value="true" />

        <!-- sensorLandscape is only the cold-start default for a first install (touch, landscape).
             The game asks for its orientation through NativeBridge.lockOrientation (portrait for the
             hilt grip), and MainActivity applies the stored one in onCreate before the WebView
             exists, so a hilt player sees one rotation of the starting window at launch.
             configChanges holds orientation|screenSize|smallestScreenSize|screenLayout, so a
             rotation never recreates the Activity or reloads the WebView. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density|fontScale|locale|layoutDirection"
            android:enableOnBackInvokedCallback="true"
            android:exported="true"
            android:hardwareAccelerated="true"
            android:label="@string/app_name"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Serves the downloaded update APK to the package installer (read-only, not exported). -->
        <provider
            android:name=".UpdateFileProvider"
            android:authorities="com.thermopylae.updates"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
